{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "configuration",
  "description": "scheme to define workflow configuration",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "id of the workflow"
    },
    "version": {
      "type": "string",
      "description": "version of the workflow"
    },
    "initialState": {
      "type": "string"
    },
    "forms": {
      "description": "forms to be used in the workflow",
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "states": {
      "description": "states in the workflow",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/state"
      },
      "minProperties": 1
    },
    "scripts": {
      "description": "scripts in the workflow",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/script"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "initialState"
  ],
  "$defs": {
    "script": {
      "title": "script",
      "type": "object",
      "description": "schema to define script",
      "properties": {
        "name": {
          "type": "string"
        },
        "runtime": {
          "type": "string"
        },
        "code": {
          "type": "string"
        }
      },
      "required": [
        "code"
      ],
      "additionalProperties": false
    },
    "execution": {
      "title": "execution",
      "type": "object",
      "description": "inline code or reusable script reference",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "inline",
            "script"
          ]
        },
        "spec": {
          "type": "object"
        }
      },
      "required": [
        "kind",
        "spec"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "inline"
              }
            }
          },
          "then": {
            "properties": {
              "spec": {
                "type": "object",
                "properties": {
                  "runtime": {
                    "type": "string"
                  },
                  "code": {
                    "type": "string"
                  }
                },
                "required": [
                  "code",
                  "runtime"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "script"
              }
            }
          },
          "then": {
            "properties": {
              "spec": {
                "type": "object",
                "properties": {
                  "script": {
                    "type": "string"
                  },
                  "function": {
                    "type": "string"
                  }
                },
                "required": [
                  "script"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      ]
    },
    "simple.action.spec": {
      "title": "action",
      "type": "object",
      "description": "schema to define actions",
      "properties": {
        "name": {
          "type": "string"
        },
        "nextState": {
          "type": "string"
        },
        "validation": {
          "$ref": "#/$defs/execution"
        },
        "operation": {
          "$ref": "#/$defs/execution"
        }
      },
      "required": [
        "name",
        "nextState"
      ],
      "additionalProperties": false
    },
    "simple.state.spec": {
      "title": "simple state",
      "type": "object",
      "description": "schema to define simple state",
      "properties": {
        "forms": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              }
            },
            "required": [
              "id"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "additionalProperties": false
        },
        "actions": {
          "type": "object",
          "description": "actions for a particular state",
          "additionalProperties": {
            "$ref": "#/$defs/simple.action.spec"
          },
          "minProperties": 1
        }
      },
      "required": [
        "forms",
        "actions"
      ],
      "additionalProperties": false
    },
    "switch.state.spec": {
      "title": "switch state",
      "type": "object",
      "description": "schema to define switch state",
      "properties": {
        "expression": {
          "$ref": "#/$defs/execution"
        },
        "operation": {
          "$ref": "#/$defs/execution"
        },
        "nextStates": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minProperties": 2
        }
      },
      "required": [
        "expression",
        "nextStates"
      ],
      "additionalProperties": false
    },
    "end.state.spec": {
      "title": "end state",
      "type": "object",
      "description": "schema to define switch state",
      "additionalProperties": false
    },
    "state": {
      "title": "state",
      "type": "object",
      "description": "schema to define state",
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "simple",
            "switch",
            "allOf",
            "anyOf",
            "doWhile"
          ]
        },
        "spec": {
          "type": "object"
        }
      },
      "required": [
        "name",
        "kind",
        "spec"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "simple"
              }
            }
          },
          "then": {
            "properties": {
              "spec": {
                "$ref": "#/$defs/simple.state.spec"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "switch"
              }
            }
          },
          "then": {
            "properties": {
              "spec": {
                "$ref": "#/$defs/switch.state.spec"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "end"
              }
            }
          },
          "then": {
            "properties": {
              "spec": {
                "$ref": "#/$defs/end.state.spec"
              }
            }
          }
        }
      ]
    }
  }
}