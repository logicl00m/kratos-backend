{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "configuration",
  "description": "scheme to define workflow configuration",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "id of the workflow"
    },
    "version": {
      "type": "string",
      "description": "version of the workflow"
    },
    "forms": {
      "description": "forms to be used in the workflow",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/form"
      }
    },
    "states": {
      "description": "states in the workflow",
      "type": "object",
      "properties": {
        "initialState": {
          "type": "string"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/state"
      },
      "minProperties": 1,
      "required": [
        "initialState"
      ]
    },
    "scripts": {
      "description": "scripts in the workflow",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/script"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "version"
  ],
  "$defs": {
    "script": {
      "title": "script",
      "type": "object",
      "description": "schema to define script",
      "properties": {
      }
    },
    "form": {
      "title": "form",
      "type": "object",
      "description": "schema to define form",
      "properties": {
        "fields": {
          "type": "object",
          "description": "Key-value mapping of fieldId → field definition",
          "additionalProperties": {
            "$ref": "#/$defs/field"
          },
          "minProperties": 1
        }
      },
      "required": [
        "fields"
      ],
      "additionalProperties": false
    },
    "text.field.spec": {
      "title": "text field",
      "type": "object",
      "description": "schema to define form text field",
      "properties": {
        "placeholder": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "placeholder"
      ]
    },
    "number.field.spec": {
      "title": "number field",
      "type": "object",
      "description": "schema to define form number field",
      "properties": {
        "placeholder": {
          "type": "string"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        }
      },
      "additionalProperties": false,
      "required": [
        "placeholder"
      ]
    },
    "simple.action.spec": {
      "title": "action",
      "type": "object",
      "description": "schema to define actions",
      "properties": {
        "name": {
          "type": "string"
        },
        "nextState": {
          "type": "string"
        },
        "validation": {
          "type": "string"
        },
        "operation": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "nextState"
      ],
      "additionalProperties": false
    },
    "simple.state.spec": {
      "title": "simple state",
      "type": "object",
      "description": "schema to define simple state",
      "properties": {
        "forms": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              }
            },
            "required": [
              "id"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "additionalProperties": false
        },
        "actions": {
          "type": "object",
          "description": "actions for a particular state",
          "additionalProperties": {
            "$ref": "#/$defs/simple.action.spec"
          },
          "minProperties": 1
        }
      },
      "required": [
        "forms",
        "actions"
      ],
      "additionalProperties": false
    },
    "switch.state.spec": {
      "title": "switch state",
      "type": "object",
      "description": "schema to define switch state",
      "properties": {
        "expression": {
          "type": "string"
        },
        "operation": {
          "type": "string"
        }
      },
      "required": [
        "expression"
      ],
      "additionalProperties": false
    },
    "field": {
      "title": "field",
      "type": "object",
      "description": "schema to define form field",
      "properties": {
        "name": {
          "type": "string"
        },
        "data": {
          "type": "string"
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "text",
            "number"
          ]
        },
        "spec": {
          "type": "object"
        }
      },
      "required": [
        "name",
        "data",
        "kind",
        "spec"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "text"
              }
            }
          },
          "then": {
            "properties": {
              "spec": {
                "$ref": "#/$defs/text.field.spec"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "number"
              }
            }
          },
          "then": {
            "properties": {
              "spec": {
                "$ref": "#/$defs/number.field.spec"
              }
            }
          }
        }
      ]
    },
    "state": {
      "title": "state",
      "type": "object",
      "description": "schema to define state",
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "simple",
            "switch",
            "allOf",
            "anyOf",
            "doWhile"
          ]
        },
        "spec": {
          "type": "object"
        }
      },
      "required": [
        "name",
        "kind",
        "spec"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "simple"
              }
            }
          },
          "then": {
            "properties": {
              "spec": {
                "$ref": "#/$defs/simple.state.spec"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "switch"
              }
            }
          },
          "then": {
            "properties": {
              "spec": {
                "$ref": "#/$defs/switch.state.spec"
              }
            }
          }
        }
      ]
    }
  }
}