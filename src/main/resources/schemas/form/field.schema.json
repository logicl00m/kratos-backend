{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kratos-api.local.fintech23.xyz/api/v1/common/public/configuration/get/form/field.schema.json",
  "title": "field",
  "type": "object",
  "description": "schema to define form field",
  "properties": {
    "name": {
      "type": "string"
    },
    "data": {
      "type": "string"
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "text",
        "number"
      ]
    },
    "spec": {
      "type": "object"
    }
  },
  "required": [
    "name",
    "data",
    "kind"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "text"
          }
        }
      },
      "then": {
        "properties": {
          "spec": {
            "$ref": "text.spec.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "number"
          }
        }
      },
      "then": {
        "properties": {
          "spec": {
            "$ref": "number.spec.schema.json"
          }
        }
      }
    }
  ]
}
