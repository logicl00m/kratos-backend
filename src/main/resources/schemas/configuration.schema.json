{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "configuration",
  "description": "scheme to define workflow configuration",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "id of the workflow"
    },
    "version": {
      "type": "string",
      "description": "version of the workflow"
    },
    "forms": {
      "description": "forms to be used in the workflow",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/form"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "version"
  ],
  "$defs": {
    "form": {
      "title": "form",
      "type": "object",
      "description": "schema to define form",
      "properties": {
        "fields": {
          "type": "object",
          "description": "Key-value mapping of fieldId → field definition",
          "additionalProperties": {
            "$ref": "#/$defs/field"
          },
          "minProperties": 1
        }
      },
      "required": [
        "fields"
      ],
      "additionalProperties": false
    },
    "textFieldSpec": {
      "title": "text field",
      "type": "object",
      "description": "schema to define form text field",
      "properties": {
        "placeholder": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "numberFieldSpec": {
      "title": "number field",
      "type": "object",
      "description": "schema to define form number field",
      "properties": {
        "placeholder": {
          "type": "string"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "field": {
      "title": "field",
      "type": "object",
      "description": "schema to define form field",
      "properties": {
        "name": {
          "type": "string"
        },
        "data": {
          "type": "string"
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "text",
            "number"
          ]
        },
        "spec": {
          "type": "object"
        }
      },
      "required": [
        "name",
        "data",
        "kind"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "text"
              }
            }
          },
          "then": {
            "properties": {
              "spec": {
                "$ref": "#/$defs/textFieldSpec"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "number"
              }
            }
          },
          "then": {
            "properties": {
              "spec": {
                "$ref": "#/$defs/numberFieldSpec"
              }
            }
          }
        }
      ]
    }
  }
}